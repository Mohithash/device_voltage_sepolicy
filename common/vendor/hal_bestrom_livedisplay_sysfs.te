type hal_bestrom_livedisplay_sysfs, domain;
hal_server_domain(hal_bestrom_livedisplay_sysfs, hal_bestrom_livedisplay)

type hal_bestrom_livedisplay_sysfs_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_bestrom_livedisplay_sysfs)

binder_call(hal_bestrom_livedisplay_sysfs, servicemanager)

# Grant access over LiveDisplay tuneables
allow hal_bestrom_livedisplay_sysfs sysfs_livedisplay_tuneable:file rw_file_perms;
