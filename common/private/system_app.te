# Allow Settings to read custom legal URL
get_prop(system_app, legal_url_prop)

# Allow Settings/Parts to read custom version
get_prop(system_app, custom_version_prop)

# Allow Settings to read ro.vendor.build.security_patch
get_prop(system_app, vendor_security_patch_level_prop)

# Allow access to the HALs
hal_client_domain(system_app, hal_ext_livedisplay)
hal_client_domain(system_app, hal_ext_touch)
hal_client_domain(system_app, hal_ext_health)

# Allow SetupWizard to set recovery update prop
set_prop(system_app, recovery_update_prop)

# Allow Settings to read default navbar prop
get_prop(system_app, qemu_hw_prop)

# Read selinux status
allow system_app selinuxfs:file r_file_perms;

# Compact HUN
allow system_app system_prop:property_service set;

# Custom ROM Hide
