# AIDL package names must match what the HAL registers and what frameworks/
# imports. Voltage renamed SELinux types to hal_bestrom_*, but several HALs
# still ship as vendor.lineage.* — both names are listed so add/find works.
#
# health:      framework + binary = lineage.*  (bestrom.* kept for rename)
# livedisplay: framework + binary = lineage.*
# powershare:  framework + binary = lineage.*
# touch:       framework + binary = bestrom.*  (fully renamed)

